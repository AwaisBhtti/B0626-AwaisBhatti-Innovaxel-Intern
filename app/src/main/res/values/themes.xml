<resources>
    <style name="Base.Theme.Splitwise" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/darkGrey</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="indicatorColor">@color/grey</item>

        <item name="android:spinnerStyle">@style/Widget.Splitwise.Spinner</item>
        <item name="textInputStyle">@style/Widget.Splitwise.TextInputLayout.OutlinedBox</item>
    </style>

    <style name="Theme.Splitwise" parent="Base.Theme.Splitwise" />

    <style name="Widget.Splitwise.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:popupBackground">@color/white</item>
    </style>

    <!-- Default style for Light Backgrounds (e.g. Login Card) -->
    <style name="Widget.Splitwise.TextInputLayout.OutlinedBox" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/text_input_box_stroke</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/darkGrey</item>
        <item name="android:textColorHint">@color/grey</item>
        <item name="endIconTint">@color/darkGrey</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <!-- Special style for Dark Backgrounds (e.g. Add Expense Screen) -->
    <style name="Widget.Splitwise.TextInputLayout.OutlinedBox.DarkBackground">
        <item name="boxStrokeColor">@color/text_input_box_stroke_white</item>
        <item name="hintTextColor">@color/white</item>
        <item name="android:textColorHint">@color/grey</item>
        <item name="endIconTint">@color/white</item>
    </style>
</resources>